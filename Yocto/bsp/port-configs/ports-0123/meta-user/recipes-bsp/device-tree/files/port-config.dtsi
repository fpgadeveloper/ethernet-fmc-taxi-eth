/*
 * Ethernet FMC port config: all 4 ports (ports-0123).
 *
 * Binds each Taxi RGMII MAC port to the taxi_mac Linux driver
 * (Linux/taxi-mac, compatible "opsero,taxi-rgmii-mac-1.0") and wires the
 * external Ethernet FMC PHY onto it. The taxi_rgmii_mac_N (module reference)
 * and axi_dma_N nodes themselves come from the SDT's pl.dtsi (generated from
 * the XSA); this overlay adds what the XSA does not carry:
 *
 *   compatible          the taxi_mac driver's binding (overrides the generic
 *                       "xlnx,taxi-rgmii-mac-1.0" that sdtgen emits for a
 *                       module reference)
 *   dmas / dma-names    the port's AXI DMA: channel 0 = MM2S (tx),
 *                       channel 1 = S2MM (rx)
 *   local-mac-address   00:0a:35:06:21:05..08 (board MAC 00:0a:35:06:21:04
 *                       + 1..4, see bsp/zcu104 board-user.dtsi)
 *   phy-mode            rgmii-rxid: the MAC drives the TX clock 90 deg late
 *                       (gtx_clk90), the PHY adds the RX delay
 *   phy-handle / mdio   the Marvell 88E1510 at address 0 on the port's own
 *                       MDIO bus (each MAC has its own MDIO master)
 *
 * Selected per target by the bsp/port-configs/ports-0123 overlay layer.
 */

&taxi_rgmii_mac_0 {
	compatible = "opsero,taxi-rgmii-mac-1.0";
	dmas = <&axi_dma_0 0>, <&axi_dma_0 1>;
	dma-names = "tx", "rx";
	phy-mode = "rgmii-rxid";
	phy-handle = <&extphy0>;
	local-mac-address = [00 0a 35 06 21 05];
	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		extphy0: ethernet-phy@0 {
			reg = <0>;
		};
	};
};

&taxi_rgmii_mac_1 {
	compatible = "opsero,taxi-rgmii-mac-1.0";
	dmas = <&axi_dma_1 0>, <&axi_dma_1 1>;
	dma-names = "tx", "rx";
	phy-mode = "rgmii-rxid";
	phy-handle = <&extphy1>;
	local-mac-address = [00 0a 35 06 21 06];
	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		extphy1: ethernet-phy@0 {
			reg = <0>;
		};
	};
};

&taxi_rgmii_mac_2 {
	compatible = "opsero,taxi-rgmii-mac-1.0";
	dmas = <&axi_dma_2 0>, <&axi_dma_2 1>;
	dma-names = "tx", "rx";
	phy-mode = "rgmii-rxid";
	phy-handle = <&extphy2>;
	local-mac-address = [00 0a 35 06 21 07];
	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		extphy2: ethernet-phy@0 {
			reg = <0>;
		};
	};
};

&taxi_rgmii_mac_3 {
	compatible = "opsero,taxi-rgmii-mac-1.0";
	dmas = <&axi_dma_3 0>, <&axi_dma_3 1>;
	dma-names = "tx", "rx";
	phy-mode = "rgmii-rxid";
	phy-handle = <&extphy3>;
	local-mac-address = [00 0a 35 06 21 08];
	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		extphy3: ethernet-phy@0 {
			reg = <0>;
		};
	};
};

/*
 * AXI DMA S2MM (rx) channels: the taxi_mac driver keeps 128 RX buffers
 * outstanding on the S2MM channel and the xilinx_dma driver sets its
 * interrupt-coalescing threshold to the number of pending descriptors, so the
 * RX completion IRQ would only fire once 128 frames had arrived. A non-zero
 * xlnx,irq-delay (1 = 125 SG-clock cycles) makes the engine raise the IRQ on
 * the delay timer as well, i.e. after every frame burst. The channel nodes are
 * generated by sdtgen as dma_channel_<8-hex address> children of axi_dma_N;
 * the S2MM channel sits at the DMA base + 0x30 (axi_dma_N at
 * 0xA0010000 + N * 0x10000 in this design).
 */
&dma_channel_a0010030 {
	xlnx,irq-delay = /bits/ 8 <1>;
};

&dma_channel_a0020030 {
	xlnx,irq-delay = /bits/ 8 <1>;
};

&dma_channel_a0030030 {
	xlnx,irq-delay = /bits/ 8 <1>;
};

&dma_channel_a0040030 {
	xlnx,irq-delay = /bits/ 8 <1>;
};
